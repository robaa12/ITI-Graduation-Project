NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=iti_grad
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?schema=public

# Mastra is started by this Compose stack and reached privately as
# http://mastra:4111. MASTRA_PORT only controls optional host access.
MASTRA_PORT=4111

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MASTRA_TIMEOUT_MS=900000
WORKFLOW_TIME_ZONE=Africa/Cairo
# Enables project knowledge retrieval once the Mastra vector service is configured.
RAG_ENABLED=false
# Local MinIO S3-compatible product-image storage. Docker Compose creates this
# bucket automatically; replace these values when moving to a hosted provider.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=iti-product-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PRODUCT_ASSETS_S3_ENDPOINT=http://localhost:9000
PRODUCT_ASSETS_S3_BUCKET=iti-product-assets
PRODUCT_ASSETS_S3_ACCESS_KEY_ID=minioadmin
PRODUCT_ASSETS_S3_SECRET_ACCESS_KEY=minioadmin
PRODUCT_ASSETS_S3_REGION=us-east-1
PRODUCT_ASSETS_S3_FORCE_PATH_STYLE=true
# Shared secret for authenticated backend-to-Mastra internal routes.
MASTRA_INTERNAL_TOKEN=replace-with-a-unique-32-character-secret

# Meta connectors are optional until configured. Generate the encryption key
# with: openssl rand -base64 32
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_REDIRECT_URI=https://api.example.com/api/connectors/meta/oauth/callback
# META_FRONTEND_REDIRECT_URL=http://localhost:5173/connectors
META_GRAPH_API_VERSION=v25.0
# META_TOKEN_ENCRYPTION_KEY=
# The embedding service stays off until the GPU/driver issue is resolved.
# The local Ollama container is opt-in: docker compose --profile local-rag up -d ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# RAG_EMBEDDING_DIMENSIONS=768
# RAG_INDEX_VERSION=pgvector-v1
# Compose constructs Mastra's pgvector URL from DB_* automatically.
RAG_POSTGRES_SCHEMA=rag
# When Ollama runs on the host, Mastra reaches it through this URL.
MASTRA_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Use a unique, high-entropy value outside local development.
BETTER_AUTH_SECRET=development-only-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed to call Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Configure a real SMTP provider before testing email delivery.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=development
SMTP_PASSWORD=development
SMTP_FROM_EMAIL=no-reply@example.com

# Stripe subscription billing. Fill with your test-mode keys locally; use
# placeholders in committed files. STRIPE_SUCCESS_URL/CANCEL_URL are where the
# browser lands after Checkout. Plans and their Stripe Price IDs live in the
# `plan` table, seeded at deploy time from a trusted config source.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_KEY
STRIPE_SUCCESS_URL=http://localhost:5173/billing?success=1
STRIPE_CANCEL_URL=http://localhost:5173/billing?canceled=1
# Stripe test-mode IDs for the `plan` table, applied via `npx prisma db seed`.
# Monthly/yearly price vars are optional; without them only the other interval works.
# STRIPE_PLAN_FREE_PRODUCT_ID=prod_xxx
# STRIPE_PLAN_PRO_PRODUCT_ID=prod_xxx
# STRIPE_PLAN_PRO_MONTHLY_PRICE_ID=price_xxx
# STRIPE_PLAN_PRO_YEARLY_PRICE_ID=price_xxx
# STRIPE_PLAN_BUSINESS_PRODUCT_ID=prod_xxx
# STRIPE_PLAN_BUSINESS_MONTHLY_PRICE_ID=price_xxx
# STRIPE_PLAN_BUSINESS_YEARLY_PRICE_ID=price_xxx
