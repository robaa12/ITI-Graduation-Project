NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=iti_grad
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?schema=public

# URL of the external Mastra workflow service.
MASTRA_BASE_URL=http://host.docker.internal:4111

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mastra runs as a separate Node service. For Docker on Linux, this points to
# a Mastra process running on the host at port 4111.
MASTRA_BASE_URL=http://host.docker.internal:4111
MASTRA_TIMEOUT_MS=600000

# Use a unique, high-entropy value outside local development.
BETTER_AUTH_SECRET=development-only-secret-change-me-32chars
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins allowed to call Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Configure a real SMTP provider before testing email delivery.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=development
SMTP_PASSWORD=development
SMTP_FROM_EMAIL=no-reply@example.com
