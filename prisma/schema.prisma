generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  projects          Project[]
  socialConnections SocialConnection[]
  metaOAuthStates   MetaOAuthState[]
  subscription      Subscription?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Application-level representation of a purchasable SaaS plan. The Stripe
/// Product/Price mapping lives here so adding a plan never requires touching
/// application code or hardcoding Stripe IDs.
model Plan {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  description          String?
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  stripeProductId      String
  stripeMonthlyPriceId String?
  stripeYearlyPriceId  String?
  // Display prices in cents (minor units) for the frontend pricing section.
  // They mirror the Stripe Prices and are the source of truth for billing.
  priceMonthlyCents    Int?
  priceYearlyCents     Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active])
  @@map("plan")
}

/// Live state of one user's Stripe subscription. Mirrors Stripe's subscription
/// status so the application can gate access without querying Stripe. Only
/// identifiers are stored — never card numbers or raw payment credentials.
model Subscription {
  id                   String              @id @default(uuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String?
  plan                 Plan?               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus  @default(INCOMPLETE)
  billingInterval      BillingInterval?
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  checkoutSessionId    String?             @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  canceledAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  events               SubscriptionEvent[]

  @@index([status])
  @@index([stripeSubscriptionId])
  @@map("subscription")
}

/// Idempotency + audit trail for Stripe webhook events. `stripeEventId` unique
/// guards against duplicate deliveries; the JSON payload preserves the raw
/// event for debugging without relying on Stripe's retry window.
model SubscriptionEvent {
  id             String        @id @default(uuid())
  stripeEventId  String        @unique
  type           String
  payload        Json
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  processedAt    DateTime      @default(now())

  @@index([subscriptionId])
  @@index([type])
  @@map("subscription_event")
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  UNPAID
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
}

enum GeneratedContentStatus {
  PENDING
  READY
  FAILED
}

enum ContentFormat {
  TEXT
  MARKDOWN
  HTML
  JSON
}

/// Lifecycle of one Mastra workflow run. SUSPENDED is a first-class state, not
/// a failure: the content workflow can pause for human approval and is picked
/// back up through the resume endpoint.
enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUSPENDED
  READY
  FAILED
}

enum WorkflowExecutionKind {
  STRATEGY
  STRATEGY_SECTION_REVISION
  CONTENT
}

enum WorkflowAccountingStatus {
  PENDING
  READY
  UNPRICED
  UNAVAILABLE
}

/// A completed strategy is not eligible for content generation until a human
/// reviewer has explicitly approved the exact stored version.
enum StrategyApprovalStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum KnowledgeSourceType {
  WEBSITE
  DOCUMENT
  FACEBOOK
  INSTAGRAM
}

enum KnowledgeSourceStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

enum SocialConnectionProvider {
  META
}

enum SocialConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

enum SocialPublicationStatus {
  QUEUED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model Project {
  id               String            @id @default(uuid())
  name             String
  description      String?
  status           ProjectStatus     @default(ACTIVE)
  archivedAt       DateTime?
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  knowledgeSources KnowledgeSource[]
  brandProfile     Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@map("project")
}

/// Project-owned material used to ground strategy and content generation.
/// The normalized text is deliberately stored separately from generated work,
/// so a source can be refreshed or removed without changing past runs.
model KnowledgeSource {
  id        String                @id @default(uuid())
  type      KnowledgeSourceType
  status    KnowledgeSourceStatus @default(PENDING)
  name      String
  url       String?
  content   String?               @db.Text
  metadata  Json?
  error     String?
  indexedAt DateTime?

  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages     KnowledgePage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, status])
  @@map("knowledge_source")
}

/// One public HTML page discovered under a website knowledge source. Keeping
/// this normalized lets retrieval cite the actual FAQ/product/about page that
/// supports a generated claim instead of only the submitted homepage.
model KnowledgePage {
  id          String   @id @default(uuid())
  url         String
  title       String
  content     String   @db.Text
  contentHash String
  error       String?
  crawledAt   DateTime @default(now())

  sourceId String
  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, url])
  @@index([sourceId])
  @@map("knowledge_page")
}

model Campaign {
  id          String             @id @default(uuid())
  name        String
  description String?
  objective   String?
  audience    String?
  tone        String?
  channels    String[]           @default([])
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus     @default(DRAFT)
  publishedAt DateTime?
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contents    GeneratedContent[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  strategies  MarketingStrategy[]
  contentRuns CampaignContentRun[]

  @@index([projectId])
  @@index([projectId, status])
  @@map("campaign")
}

/// One run of the Mastra `marketingStrategyWorkflow`, always scoped to the
/// campaign it was started from.
model MarketingStrategy {
  id String @id @default(uuid())

  /// Mastra's own run id. Null until the worker has reserved a run — the row
  /// exists first so a crash between insert and reservation is still visible.
  runId String? @unique

  status WorkflowRunStatus @default(PENDING)

  /// Exactly what the client posted, forwarded to Mastra untouched. Kept so a
  /// run can be replayed and so a schema change on the Mastra side never
  /// silently rewrites history.
  input Json

  /// Full workflow result. `campaignStrategy` inside it is what the content
  /// workflow consumes.
  output Json?

  /// Payload Mastra returned when it suspended, describing what it is waiting
  /// for. Null in every other state.
  suspendPayload Json?

  /// One-off input for a focused section revision. Kept separate from the
  /// original workflow input so the complete strategy remains replayable.
  pendingRevision Json?

  error String?

  approvalStatus StrategyApprovalStatus @default(PENDING_REVIEW)
  reviewedAt     DateTime?
  reviewerId     String?
  reviewerName   String?
  reviewNote     String?
  reviewEvents   StrategyReviewEvent[]
  executions     WorkflowExecution[]

  campaignId  String
  campaign    Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contentRuns CampaignContentRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([campaignId, status])
  @@map("marketing_strategy")
}

/// Immutable audit trail for the review decision. Reviewer identity is stored
/// as a snapshot so a historical decision remains understandable even if the
/// user later changes their profile details.
model StrategyReviewEvent {
  id           String                 @id @default(uuid())
  action       StrategyApprovalStatus
  note         String?
  reviewerId   String
  reviewerName String
  output       Json?

  strategyId String
  strategy   MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([strategyId, createdAt])
  @@map("strategy_review_event")
}

/// One run of the Mastra `contentCreationWorkflow`. Holds the raw workflow
/// payload; the calendar entries are also fanned out into GeneratedContent so
/// the existing list/export/edit endpoints keep working on them.
model CampaignContentRun {
  id String @id @default(uuid())

  runId String? @unique

  status WorkflowRunStatus @default(PENDING)

  input          Json
  output         Json?
  suspendPayload Json?
  error          String?

  /// Number of GeneratedContent rows fanned out from `output.calendar`.
  contentCount Int                 @default(0)
  contents     GeneratedContent[]
  executions   WorkflowExecution[]

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Strategy this content was generated from. Kept nullable and SetNull so
  /// deleting a strategy never destroys the content produced from it.
  strategyId String?
  strategy   MarketingStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([campaignId, status])
  @@index([strategyId])
  @@map("campaign_content_run")
}

/// Immutable accounting record for one concrete Mastra run. Strategy section
/// revisions get their own row even though they update the same strategy.
model WorkflowExecution {
  id          String                @id @default(uuid())
  mastraRunId String                @unique
  workflowId  String
  kind        WorkflowExecutionKind
  status      WorkflowRunStatus     @default(PENDING)

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  estimatedCost    Decimal?                 @db.Decimal(20, 10)
  costUnit         String?
  accountingStatus WorkflowAccountingStatus @default(PENDING)
  modelBreakdown   Json?
  usageCollectedAt DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?

  strategyId String?
  strategy   MarketingStrategy? @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  contentRunId String?
  contentRun   CampaignContentRun? @relation(fields: [contentRunId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strategyId, createdAt])
  @@index([contentRunId, createdAt])
  @@index([accountingStatus])
  @@map("workflow_execution")
}

model GeneratedContent {
  id      String                 @id @default(uuid())
  type    String
  title   String?
  body    String?
  payload Json?
  format  ContentFormat          @default(TEXT)
  status  GeneratedContentStatus @default(READY)
  prompt  String?
  model   String?
  error   String?

  /// Successful generations of this row. User-facing: bumped only when the
  /// agent actually produces something, never by a request or a failure.
  version Int @default(1)

  /// Bumped by anything that supersedes an in-flight generation: a new
  /// regenerate, or a manual edit. A worker writes its result only while this
  /// still matches the value its job was queued with, so a slow job can never
  /// overwrite newer data. Not user-facing.
  generationRevision Int @default(0)

  isEdited   Boolean  @default(false)
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Set when the row was fanned out from a content workflow run. Null for
  /// rows produced by the per-item generate/regenerate pipeline. SetNull so
  /// deleting a run leaves the content it produced in place.
  contentRunId String?
  contentRun   CampaignContentRun? @relation(fields: [contentRunId], references: [id], onDelete: SetNull)
  publications SocialPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([campaignId, type])
  @@index([contentRunId])
  @@map("generated_content")
}

/// One OAuth grant for a provider. Tokens are AES-GCM ciphertext and are never
/// returned through the HTTP API.
model SocialConnection {
  id       String                   @id @default(uuid())
  provider SocialConnectionProvider
  status   SocialConnectionStatus   @default(ACTIVE)

  externalUserId        String?
  accessTokenCiphertext String
  accessTokenExpiresAt  DateTime?
  grantedScopes         String[]  @default([])
  lastSyncedAt          DateTime?
  lastError             String?

  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts SocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId, status])
  @@map("social_connection")
}

/// A Facebook Page or linked Instagram professional account discovered from a
/// Meta connection. Page tokens are encrypted independently so publishing does
/// not need to expose or reuse the user token.
model SocialAccount {
  id         String         @id @default(uuid())
  platform   SocialPlatform
  externalId String
  name       String
  username   String?
  imageUrl   String?
  tasks      String[]       @default([])

  accessTokenCiphertext String
  selected              Boolean @default(false)
  available             Boolean @default(true)

  connectionId String
  connection   SocialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, platform, externalId])
  @@index([connectionId, selected])
  @@map("social_account")
}

/// One-time OAuth state. Only a SHA-256 hash is persisted, so a database read
/// cannot recover a state value that is still usable at the callback.
model MetaOAuthState {
  id        String   @id @default(uuid())
  stateHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("meta_oauth_state")
}

/// Durable scheduling and provider-delivery record. A revision invalidates a
/// delayed job when the publication is cancelled or retried.
model SocialPublication {
  id                String                  @id @default(uuid())
  status            SocialPublicationStatus @default(QUEUED)
  scheduledFor      DateTime
  caption           String
  mediaUrl          String?
  platform          SocialPlatform
  accountName       String
  externalAccountId String
  publishedAt       DateTime?
  externalPostId    String?
  error             String?
  revision          Int                     @default(1)

  contentId String
  content   GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId])
  @@index([socialAccountId, status])
  @@index([status, scheduledFor])
  @@map("social_publication")
}
